<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace: 이 XML과 1:1로 연결될 DAO 인터페이스의 전체 패키지 경로 지정 -->
<mapper namespace="com.mbc.mtps.dao.BoardDao">

    <!--
        resultMap: DB의 컬럼명(snake_case)과 DTO의 변수명(camelCase)을 1:1로 매핑해주는 설정
        - type: 매핑 결과를 담을 DTO 클래스의 전체 패키지 경로
        - regDate를 DTO에서 String으로 변경했어도 DB 날짜 데이터를 MyBatis가 알아서 String으로 매핑해 줌
    -->
    <resultMap id="boardMap" type="com.mbc.mtps.dto.BoardDto">
        <id property="boardNo" column="board_no"/>       <!-- PK (기본키) 컬럼 매핑 -->
        <result property="title" column="title"/>         <!-- 글 제목 매핑 -->
        <result property="content" column="content"/>     <!-- 글 내용 매핑 -->
        <result property="id" column="id"/>               <!-- 작성자 아이디 매핑 -->
        <result property="regDate" column="reg_date"/>   <!-- 작성일자 매핑 (DB reg_date -> DTO regDate) -->
        <result property="viewCnt" column="view_cnt"/>   <!-- 조회수 매핑 -->
    </resultMap>
 
    <!--
        [1. 게시글 전체 목록 조회]
        - id: BoardDao 인터페이스의 메서드 이름과 동일해야 함 (getBoardList)
        - resultMap: 위에 정의한 boardMap 구조를 사용하여 조회 결과를 DTO에 담음
        - parameterType: 페이징 정보를 담은 BoardParam 객체를 전달받음
    -->
<select id="getBoardList"
    parameterType="com.mbc.mtps.dto.BoardParam"
    resultMap="boardMap">

    SELECT board_no, title, content, id,
           TO_CHAR(reg_date, 'YYYY-MM-DD HH24:MI:SS') AS reg_date,
           view_cnt
    FROM board
    <if test="keyword != null and keyword != ''">
        WHERE title LIKE CONCAT('%', #{keyword}, '%')
           OR content LIKE CONCAT('%', #{keyword}, '%')
           OR id LIKE CONCAT('%', #{keyword}, '%')
    </if>
    ORDER BY board_no DESC

    <!-- 한 페이지에 보여줄 게시글 개수 (현재 10개) -->
    LIMIT #{pageSize}

    <!-- 현재 페이지 이전의 게시글을 몇 개 건너뛸지 결정 -->
    OFFSET #{offset}

</select>

    <!--
        [1-1. 전체 게시글 개수 조회]
        - 페이징 처리 시 전체 페이지 수를 계산하기 위해 사용
        - resultType: 단순 숫자 하나만 반환하므로 resultMap이 아닌 resultType 사용
    -->
    <select id="getBoardCount" parameterType="com.mbc.mtps.dto.BoardParam" resultType="int">
    SELECT COUNT(*)
    FROM board
    <if test="keyword != null and keyword != ''">
        WHERE title LIKE CONCAT('%', #{keyword}, '%')
           OR content LIKE CONCAT('%', #{keyword}, '%')
           OR id LIKE CONCAT('%', #{keyword}, '%')
    </if>
</select>

    <!--
        [2. 게시글 상세 조회]
        - parameterType: 매개변수로 넘어오는 데이터의 타입 (int boardNo)
        - #{boardNo}: BoardDao에서 전달받은 파라미터 값이 들어가는 위치
    -->
    <select id="getBoard" parameterType="int" resultMap="boardMap">
        SELECT board_no, title, content, id,
               TO_CHAR(reg_date, 'YYYY-MM-DD HH24:MI:SS') AS reg_date,
               view_cnt
        FROM board
        WHERE board_no = #{boardNo}
    </select>

    <!--
        [3. 게시글 등록]
        - parameterType: 저장할 데이터가 담긴 DTO 객체의 전체 경로
        - #{title}, #{content}, #{id}: BoardDto의 getter 메서드를 호출하여 값을 바인딩함
    -->
    <insert id="insertBoard" parameterType="com.mbc.mtps.dto.BoardDto">
        INSERT INTO board (title, content, id)
        VALUES (#{title}, #{content}, #{id})
    </insert>

    <!--
        [4. 게시글 조회수 1 증가]
        - 게시글 상세 보기 시 view_cnt 값을 1씩 누적 증가시킴
    -->
    <update id="updateViewCnt" parameterType="int">
        UPDATE board SET view_cnt = view_cnt + 1
        WHERE board_no = #{boardNo}
    </update>

    <!--
        [5. 게시글 수정]
        - board_no와 id(작성자)가 둘 다 일치할 때만 수정됨 (본인 글만 수정 가능하도록 방어)
    -->
    <update id="updateBoard" parameterType="com.mbc.mtps.dto.BoardDto">
        UPDATE board
        SET title = #{title},
            content = #{content}
        WHERE board_no = #{boardNo} AND id = #{id}
    </update>

    <!--
        [6. 게시글 삭제]
        - board_no만 파라미터로 받되, 컨트롤러/서비스 단에서 작성자 검증 후 호출
        - 필요시 id까지 같이 넘겨 WHERE 조건에 추가하는 방식으로 방어를 더 강화할 수 있음
    -->
    <delete id="deleteBoard" parameterType="int">
        DELETE FROM board
        WHERE board_no = #{boardNo}
    </delete>

</mapper>